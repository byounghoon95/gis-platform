# Standalone frontend development environment
# Copy this file to frontend/.env.local before running Vite from frontend/:
# npm run dev

# Backend API base URL used by the React app.
VITE_API_BASE_URL=http://localhost:8080

# Google Maps JavaScript API key used by the dashboard map.
# Use a restricted key, for example allowing:
# http://localhost:5173/*
# http://127.0.0.1:5173/*
VITE_GOOGLE_MAPS_API_KEY=
