# Docker Compose environment
# Copy this file to .env in the repository root before running:
# docker compose up -d

# PostgreSQL/PostGIS container
POSTGRES_DB=gis_platform
POSTGRES_USER=gis_user
POSTGRES_PASSWORD=gis_password
POSTGRES_PORT=5432

# Spring Boot backend container
BACKEND_PORT=8080
JWT_SECRET=local-dev-jwt-secret-change-me-32chars
JWT_EXPIRATION_SECONDS=3600
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234
ADMIN_NAME=Admin

# React/Vite frontend container
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080

# Google Maps JavaScript API key for the frontend map.
# Keep the real value only in .env or frontend/.env.local, never in Git.
VITE_GOOGLE_MAPS_API_KEY=
